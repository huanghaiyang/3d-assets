#!/bin/sh
#
# 提交前拦截：后端运行数据与密钥一律不得入库。
# 安装：git config core.hooksPath .githooks
# 绕过（不建议）：git commit --no-verify
#

fail() {
  echo ""
  echo "✖ 提交被阻止：$1"
  echo "  如确认无误，可临时用 git commit --no-verify 绕过。"
  echo ""
  exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ---------- 1) 路径黑名单 ----------
# 运行期数据目录、.env（放行 .env.example）、证书私钥
blocked=$(printf '%s\n' "$staged" \
  | grep -E '(^|/)\.env$|(^|/)\.env\.(local|development|production|test)$|(^|/)data/|\.(pem|key|p12|pfx)$' \
  | grep -v -E '(^|/)\.env\.example$' || true)

if [ -n "$blocked" ]; then
  echo "以下暂存文件属于敏感数据："
  echo "$blocked" | sed 's/^/  - /'
  fail "后端数据目录（data/）与环境变量文件（.env）不得提交"
fi

# ---------- 2) 内容扫描：疑似真实 API Key ----------
# 真实密钥形如 sk-<48 位> / tsk_<...> / msy_<...>；占位符（sk-xxxx…16 位）不会误报
hits=$(git diff --cached -U0 --diff-filter=ACM \
  | grep -E '^\+' \
  | grep -v -E '^\+\+\+' \
  | grep -Eo '(sk-|tsk_|msy_)[A-Za-z0-9]{20,}' \
  | sort -u || true)

if [ -n "$hits" ]; then
  echo "疑似真实 API Key（已打码）："
  echo "$hits" | sed -E 's/^(.{6}).*(.{4})$/\1****\2/' | sed 's/^/  - /'
  fail "检测到疑似密钥内容"
fi

# ---------- 3) 大文件提醒（避免误提交模型/缓存） ----------
big=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c <"$f" 2>/dev/null || echo 0)
  [ "$size" -gt 10485760 ] && echo "  - $f ($((size / 1048576)) MB)"
done || true)

if [ -n "$big" ]; then
  echo "注意：以下暂存文件大于 10MB"
  echo "$big"
fi

exit 0

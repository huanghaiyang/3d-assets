# ===== 生成引擎：默认 hunyuan3d，可插拔 tripo3d / meshy =====
# 每个引擎的 Key 独立配置；界面「设置」里填写的 Key 优先级更高。
# 默认引擎（hunyuan3d / tripo3d / meshy）
GENERATION_PROVIDER=hunyuan3d

# --- 腾讯云混元生3D（默认引擎）---
# 在 https://console.cloud.tencent.com/ai3d/start 创建 API Key（以 sk- 开头）
# 也可以不配置，启动后在界面右上角“设置”里填写
HUNYUAN3D_API_KEY=

# 接口域名（一般无需修改）
HUNYUAN3D_BASE_URL=https://api.ai3d.cloud.tencent.com

# --- Tripo3D ---
# 在 https://platform.tripo3d.ai/api-keys 创建 API Key（以 tsk_ 开头）
TRIPO3D_API_KEY=
TRIPO3D_BASE_URL=https://api.tripo3d.ai/v2/openapi

# --- Meshy ---
# 在 https://www.meshy.ai/api 创建 API Key（以 msy_ 开头）
MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai/openapi/v2

# 本地服务
HOST=127.0.0.1
PORT=8788

# 远端任务轮询间隔（毫秒）
POLL_INTERVAL_MS=5000

# 本地并发上限（接口默认提供 3 个并发，最大 3）
MAX_CONCURRENCY=3

# ===== 动画预览 =====
# FBX 动画文件夹（只读，不会被写入或锁定）；留空则用 ../CozyVale/assets/mixamo
ANIMATION_DIR=

# ===== Kimodo 动作生成 =====
# 可执行文件与模型权重路径必须在这里配置，不允许写死在代码里
KIMODO_GENERATE_EXE=
KIMODO_MOTION_MODEL=
KIMODO_TEXT_BUNDLE=
# 生成产物目录（中间产物会保留在这里，可在界面查看）
KIMODO_OUTPUT_DIR=
# to_mixamo.py 的 Python 解释器
KIMODO_PYTHON=
# 推理后端：cpu / cuda
KIMODO_BACKEND=cpu
# 文本编码器分层驻留块数，留空用生成器默认值
KIMODO_TEXT_LAYER_CHUNK=

# ===== 提示词转译（DeepSeek，OpenAI 兼容接口）=====
# 用于把中文描述 / 参考图片转译成 Kimodo 的英文动作提示词；Key 只在服务端使用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉理解模型名
KIMODO_PROMPT_MODEL=deepseek-flash
# 转译请求超时（毫秒）
KIMODO_PROMPT_TIMEOUT_MS=90000

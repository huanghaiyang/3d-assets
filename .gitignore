# ==========================================================
# 敏感：后端数据与凭据，绝不入库
# ==========================================================

# 环境变量（内含 HUNYUAN3D_API_KEY 等真实密钥）；模板 .env.example 可以入库
.env
.env.local
.env.*.local

# 运行期数据目录：state.json（API Key / 任务元数据）、payloads（上传的输入图）、
# storage（转存/上传的模型）、uploads（上传暂存）
data/
apps/*/data/

# 证书与私钥
*.pem
*.key
*.p12
*.pfx

# ==========================================================
# 依赖与构建产物
# ==========================================================
node_modules/
dist/
.npm-cache/
.tmp/
.tmp-test/
.tmp-build/
.tmp-probe/
*.tsbuildinfo
*.log
tools/kimodo-shim/build/
*.obj
*.exe
*.dll
*.tlog

# ==========================================================
# 编辑器 / 操作系统
# ==========================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

train/

{
  "name": "@h3d/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-files.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:providers": "tsx src/scripts/provider-selftest.ts",
    "test:state": "tsx src/scripts/state-recovery-test.ts",
    "test:cover": "tsx src/scripts/cover-selftest.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gl": "^8.1.6",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
